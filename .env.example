# Notion integration PAT (server-only — never expose to the browser).
# Required. Get from https://www.notion.so/profile/integrations
NOTION_TOKEN=ntn_paste_the_lead_forms_pat_here

# Public app URL used in metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HTTP Basic Auth password gate (proxy.ts) for non-production access.
# REQUIRED on every deployed environment — if unset, all routes return 503.
# Username field is ignored, only the password is checked.
# PREVIEW_PASSWORD=change-me
